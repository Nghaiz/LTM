# Required by plans/00-shared/conventions.md section 1.3.
# Unity rewrites these YAML assets on every Editor open; without a merge driver
# the conflicts are thousand-line YAML blobs that cannot be resolved by hand.
#
# To activate unityyamlmerge locally, each developer runs once:
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver '"<UnityInstall>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %A %B %A'

*.unity   merge=unityyamlmerge eol=lf
*.prefab  merge=unityyamlmerge eol=lf
*.asset   merge=unityyamlmerge eol=lf

# TerrainData is a native binary asset despite its .asset suffix. Treating it as YAML makes
# Git's line-ending filter report a byte-identical Editor round trip as a binary modification.
Ironfront_Reborn/Assets/TerrainData/*.asset binary

# Unity binary assets — never diff or merge these.
*.psd      binary
*.fbx      binary
*.tga      binary
*.dds      binary
*.unitypackage binary

# Normalize line endings for source and scripts.
*.cs       text eol=lf diff=csharp
*.csproj   text eol=lf
*.sln      text eol=crlf
*.props    text eol=lf
*.md       text eol=lf
*.ps1      text eol=crlf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
# Shell scripts MUST be LF even when checked out on Windows. They were safe while they only
# ever reached the VM via a Linux `git clone` (cloud-init), but infra/compose/push-and-run.sh
# scp's one straight from the Windows working tree — and a CRLF shebang makes the Linux kernel
# hunt for an interpreter literally named `bash\r`: "bad interpreter: no such file or directory".
*.sh       text eol=lf

# Dotfiles and extensionless config. Without these, core.autocrlf checks them out as CRLF on
# Windows while .editorconfig declares `end_of_line = lf` for the same files — the two then
# disagree forever and every editor save produces a whole-file diff.
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
CODEOWNERS      text eol=lf
LICENSE         text eol=lf

# Git LFS: large binary art is stored as pointers, so a clone fetches only the revision it checks
# out rather than every version ever committed. The ForestLake terrain is tens of MB a revision
# and the ForestLake environment pack's textures run to ~100 MB a file, which plain Git on GitHub
# refuses outright. A machine needs `git lfs install` once (Git for Windows ships git-lfs).
# Scoped to these paths on purpose: a repo-wide *.png rule would turn every PNG already committed
# as a normal blob into a pending "modification".
Ironfront_Reborn/Assets/TerrainData/ForestLake_Terrain.asset filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.png filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.PNG filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.tga filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.TGA filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.FBX filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.exr filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/ForestLake/**/*.psd filter=lfs diff=lfs merge=lfs -text
# The weapon models the reskin (Assets/Editor/Weapons) bakes from: ~140 MB of meshes and
# textures, the largest a 16 MB FBX.
Ironfront_Reborn/Assets/WeaponModels/**/*.png filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/WeaponModels/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/WeaponModels/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Ironfront_Reborn/Assets/WeaponModels/**/*.obj filter=lfs diff=lfs merge=lfs -text
