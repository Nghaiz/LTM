# Ironfront headless game server — templated systemd unit (phase 03 task 1).
#
# SUPERSEDED by infra/compose/compose.yaml, which is the phase-03 deployment path (a single
# VM running Docker Compose with images pulled from GHCR). This unit is kept as the fallback
# for a non-container VM; if you use it, the port convention below is the honest one.
#
# The @ makes this a template: %i is the instance number, so one file runs every server.
#   sudo systemctl enable --now ironfront-gameserver@15
#   sudo systemctl enable --now ironfront-gameserver@16
#
# Instance N listens on UDP port 270N — so @15 binds 27015 and @16 binds 27016, and the
# instance number reads as the last digits of the port. The pair above matches the 27015-27020
# UDP range docs/operations.md and tools/deploy.sh open; enable @17..@20 for more instances.
#
# OWNER NOTE: the Unity headless build itself is Dev A's and Dev C's; this unit is Dev D's
# deployment wrapper around whatever they produce. It is written against the build layout
# tools/build-server.ps1 emits.

[Unit]
Description=Ironfront Game Server instance %i (UDP)
After=network-online.target ironfront-master.service
Wants=network-online.target

StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=ironfront
Group=ironfront
WorkingDirectory=/opt/ironfront/gameserver

# The same shared secret as the master: joinTickets are HMAC-signed by the master and
# verified here, and a mismatch denies every CONNECT_REQUEST with reason 3.
EnvironmentFile=/opt/ironfront/.env

# Until Ironfront.Net.Configuration landed, NEITHER of this unit's two ways of setting the
# port did anything: no code read IRONFRONT_GAMESERVER_UDP_PORT, and no code parsed the
# -port argument on the ExecStart line below. Both instances bound whatever the scene asset
# said, which is 27015 for both — so the second one failed to bind and the file looked
# correct while doing it. The variable is live now and -port is gone rather than left in
# place to be trusted again.
#
# systemd does no arithmetic in Environment=, so this is string concatenation: 270 + %i.
# An earlier 2701%i emitted 27011/27012 for @1/@2 while the header promised 27015/27016 —
# honest now because the instance number IS the last two digits, so @15 -> 27015.
Environment=IRONFRONT_GAMESERVER_UDP_PORT=270%i

# The scene ships with the loopback transport on, because that is what a single-Editor test
# wants. A headless instance left on it starts cleanly, logs nothing unusual and accepts
# nobody — so a deployment states the transport rather than inheriting it.
Environment=IRONFRONT_GAMESERVER_TRANSPORT=udp

# Likewise the development shortcut: with unsigned tickets accepted, anyone can join as
# anyone. Off here, which makes a missing IRONFRONT_SHARED_SECRET a server that refuses
# every connection rather than one that admits every connection.
Environment=IRONFRONT_GAMESERVER_ACCEPT_UNSIGNED_TICKETS=0

# The master runs on the same box (After= above). Empty would mean standalone: matches play
# to completion but the server is never advertised, so nobody is matched into it.
Environment=IRONFRONT_MASTER_HOST=127.0.0.1

# -batchmode -nographics is what makes a Unity build runnable on a headless VPS at all;
# without them it tries to initialise a graphics device and exits.
ExecStart=/opt/ironfront/gameserver/Ironfront.Server.x86_64 \
    -batchmode -nographics \
    -logFile /var/log/ironfront/gameserver-%i.log

Restart=always
RestartSec=5
TimeoutStopSec=30

# Expect 500 MB - 1.5 GB resident per instance. On a 4 GB VPS running the master plus two
# instances that is the constraint to watch; MemoryMax turns "the OOM killer picked a
# process at random" into "this instance was restarted", which is diagnosable.
MemoryMax=1600M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ironfront /var/log/ironfront

[Install]
WantedBy=multi-user.target
