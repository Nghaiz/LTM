<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OWNER: Dev C.

    Why this project exists next to Ironfront.Net.Protocol.Tests rather than inside it:
    that project references Ironfront.Net.Protocol and nothing else, deliberately, so the
    frozen protocol library is verified in isolation. The suites here need
    Ironfront.Net.Replication and Ironfront.Net.Transport too — the snapshot/delta core,
    the server tick loop, and the simulator.

    Conformance/ keeps the implementer/verifier split that conventions.md section 7 is
    built around: BitWriter and BitReader are Dev B's code, and the tests that judge them
    are Dev C's, written from protocol-spec.md with hand-written hex rather than from
    B's implementation. A round-trip test would only prove the code agrees with itself.

    net8.0, not netstandard2.1: this is a test host and is never loaded by Unity.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ironfront.Net.Replication.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    No Version attributes: Central Package Management is on (Directory.Packages.props), and
    CentralPackageVersionOverrideEnabled=false makes an inline version an NU1008 error on
    purpose. Versions live in Directory.Packages.props.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironfront.Net.Protocol\Ironfront.Net.Protocol.csproj" />
    <ProjectReference Include="..\Ironfront.Net.Replication\Ironfront.Net.Replication.csproj" />
    <ProjectReference Include="..\Ironfront.Net.Transport\Ironfront.Net.Transport.csproj" />
    <!--
      Phase 03 task 4: the master-server link. Both are here so the adapter is exercised
      against the real IGameServerLink shape (via FakeGameServerLink) rather than against a
      hand-written stand-in that could drift from it.
    -->
    <ProjectReference Include="..\Ironfront.MasterClient\Ironfront.MasterClient.csproj" />
    <ProjectReference Include="..\Ironfront.Net.MasterLink\Ironfront.Net.MasterLink.csproj" />
    <!--
      phase-V10 task 11. The client-wiring gate's detectors are pure functions over a parsed
      syntax tree precisely so their RED paths can be exercised here: a gate nobody has watched
      fail is unproven, and this one exists because six router events reached production unwired.
      Referencing the tool from the test project is what makes that possible.
    -->
    <ProjectReference Include="..\tools\ClientWiringGate\ClientWiringGate.csproj" />
    <!--
      phase-V3 task 10, same reasoning one gate over. SpecChecker's vehicle-registry judgement is
      a pure function over (prefab name, id) records precisely so its four failure classes — a
      reassigned id, an id the registry does not know, an id no prefab carries, an unauthored
      prefab — are driven from a fixture on every CI run. All four are silent on both sides of
      the wire, which is what makes watching them go red the point.
    -->
    <ProjectReference Include="..\tools\SpecChecker\SpecChecker.csproj" />
    <!--
      debt-closure, issue #151. JoinTicketSenderTests grades the ticket a Unity client presents,
      and both halves of that ticket come from configuration: GameClientConfig.PlayerId (which
      must differ per instance, or the server's one-session-per-player claim turns the second
      join into a bare InvalidTicket) and DisplayName (which is where a killfeed line gets its
      name). Pinning the mint without the config would grade JoinTicket.Issue, which was never
      the broken half.
    -->
    <ProjectReference Include="..\Ironfront.Net.Configuration\Ironfront.Net.Configuration.csproj" />
  </ItemGroup>

  <!--
    debt-closure phase 3C. Same arrangement Ironfront.Client.Input.Tests and
    Ironfront.Client.Flow.Tests already use, and for the same reason: the code lives under
    Ironfront_Reborn/Assets/Scripts because that is where Unity has to compile it from, Assets/
    has no .asmdef, so there is no assembly for a .NET project to reference and no Unity Test
    Framework either. Compiling the source a second time here is the only way `dotnet test`
    reaches it.

    Linked here rather than into Ironfront.Client.Flow.Tests because the pin that matters drives
    the payload through the real ServerMessageRouter, and Flow.Tests deliberately does not
    reference Ironfront.Net.Replication.

    THE ONE RULE: no UnityEngine in a linked file. A `using UnityEngine;` added to
    BaselineAckPolicy fails this build rather than silently dropping it out of coverage - which
    is exactly the fate its subject, AckBaselineMessage, had for four phases.
  -->
  <ItemGroup>
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Client\BaselineAckPolicy.cs"
             Link="Linked\BaselineAckPolicy.cs" />
  </ItemGroup>

</Project>
