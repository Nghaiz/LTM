<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OWNER: Dev A (written by the lead's assist track,
    plans/assist-dev-a/step-02-input-source.md).

    WHY THIS PROJECT IS SHAPED LIKE THIS

    It has no library to reference. The code it tests lives under
    Ironfront_Reborn/Assets/Scripts/Net/Input/ because that is where Unity has to be able
    to compile it from, and Assets/ has no .asmdef — so the Unity Test Framework is not
    available, and there is no assembly for a .NET project to reference either.

    Compiling the same source files a second time here is the only way anything under
    Assets/ is reachable by `dotnet test`, which is the assist track's rule 2: logic goes
    somewhere dotnet test can reach it, Unity gets a thin adapter. The alternative —
    building a netstandard2.1 library and copying its DLL into Assets/Plugins — would work
    and costs a new plugin DLL, a hand-written .meta and a build-libs.ps1 entry for five
    small types. The link is cheaper and has one failure mode, guarded below.

    THE ONE RULE FOR THE LINKED FILES: no UnityEngine.

    A `using UnityEngine;` in any file listed below fails the build here rather than
    silently dropping out of coverage, which is the whole reason the Unity-only half
    (LocalInputSource, InputShadowCompare) is not in the list.

    NOTE the two compilers disagree slightly and the linked files must satisfy both:
      - Unity 6000.3 compiles C# 9. LangVersion here is 12 (Directory.Build.props), so
        this project will happily accept syntax Unity rejects. Nothing catches that but
        review.
      - Nullable and TreatWarningsAsErrors are on here (root Directory.Build.props) and off
        in Unity (Ironfront_Reborn/Directory.Build.props is empty on purpose). So this
        project is the stricter of the two, which is the useful direction.

    net8.0, not netstandard2.1: this is a test host and is never loaded by Unity.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ironfront.Client.Input.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironfront.Net.Protocol\Ironfront.Net.Protocol.csproj" />
  </ItemGroup>

  <!--
    Listed one by one rather than with a wildcard, on purpose: a glob would quietly pull in
    the next Unity-only file somebody adds to that folder and fail with a screenful of
    UnityEngine errors that look like a broken build rather than a misplaced file.
  -->
  <ItemGroup>
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Input\IInputSource.cs"
             Link="Linked\IInputSource.cs" />
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Input\InputButtonPacker.cs"
             Link="Linked\InputButtonPacker.cs" />
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Input\InputSourceExtensions.cs"
             Link="Linked\InputSourceExtensions.cs" />
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Input\NetInputSource.cs"
             Link="Linked\NetInputSource.cs" />
    <Compile Include="..\Ironfront_Reborn\Assets\Scripts\Net\Input\NullInputSource.cs"
             Link="Linked\NullInputSource.cs" />
  </ItemGroup>

</Project>
