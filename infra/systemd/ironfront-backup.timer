# Runs the Ironfront backup every 6 hours. Enable with:
#   sudo systemctl enable --now ironfront-backup.timer

[Unit]
Description=Run the Ironfront backup every 6 hours

[Timer]
# 00:00, 06:00, 12:00, 18:00 UTC.
OnCalendar=00/6:00
# Catch up one missed run after the VM was off, rather than waiting for the next slot.
Persistent=true
# Spread load off the exact minute boundary (and off every other VM doing the same).
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
