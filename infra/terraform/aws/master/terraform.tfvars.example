# cp terraform.tfvars.example terraform.tfvars   (gitignored; nothing here is secret anyway)

# The image the master boots with the FIRST time. Later deploys: ./infra/terraform/aws/master/deploy.sh.
# What runs now: gh variable get LIVE_MASTER_IMAGE --repo Nghaiz/LTM
master_image = "ghcr.io/nghaiz/ironfront-master@sha256:<64 hex>"

# region         = "ap-southeast-2"   # the only region the org SCP allows
# instance_type  = "m7i-flex.large"  # 2 vCPU / 8 GiB, amd64, free-tier eligible
# master_domain  = ""                # empty = <elastic-ip>.sslip.io
# acme_email     = "you@example.com"
# ssh_public_key = "ssh-ed25519 AAAA... you@host"   # optional; SSM Session Manager works without it
# ssh_cidrs      = ["203.0.113.7/32"]
