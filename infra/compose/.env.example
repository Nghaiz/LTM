# Ironfront deployment environment — TEMPLATE. Copy to `.env` beside compose.yaml on the
# VM and fill it in. COMMIT this template; NEVER commit the real .env.
#
#   cp .env.example .env && chmod 600 .env      # then edit
#
# This file is read TWICE and the two readers see different paths on purpose:
#   1. docker compose, for ${...} interpolation in compose.yaml (image refs, domain,
#      public IP, tuning). Compose does NOT inject these into containers unless a service
#      references them — the master's in-container paths are hardcoded to /data and /tls.
#   2. the HOST systemd timers (infra/systemd: backup + alert), which read this same file
#      and therefore need HOST paths (the bind-mount SOURCES under /opt/ironfront), not the
#      container's /data view.
#
# Secrets (the shared secret, the certificate password, the alert webhook) are filled in
# OUT OF BAND on the VM — never through a commit, a PR, an issue or a screenshot. The GHCR
# pull credential is NOT stored here at all; deploy.sh takes it as a one-shot login.

# --- Images (pin to an immutable digest or commit-SHA tag, NEVER :latest) -------------
# The exact references .github/workflows/images.yml pushed. Prefer @sha256:... digests so
# `docker compose pull` can never drift under a moved tag.
IRONFRONT_MASTER_IMAGE=ghcr.io/OWNER/ironfront-master@sha256:REPLACE_WITH_DIGEST
IRONFRONT_GAMESERVER_IMAGE=ghcr.io/OWNER/ironfront-game-server@sha256:REPLACE_WITH_DIGEST

# --- Identity and public endpoint -----------------------------------------------------
# The HMAC key that signs/verifies joinTickets. >=32 chars, generated on the box:
#   openssl rand -base64 48
# The master refuses to start without it; both game servers must carry the SAME value.
IRONFRONT_SHARED_SECRET=

# The hostname the master's TLS certificate is issued for (your domain's A record points
# at IRONFRONT_PUBLIC_IP). Clients validate the master certificate against this name, and
# the game servers reuse it as the TLS target host while dialing the internal service.
IRONFRONT_DOMAIN=master.example.com

# The VM's static public IPv4 (Terraform outputs it). The master advertises THIS to
# players for the UDP data plane, so it must be a real, reachable literal — not a domain
# and never a container-private address.
IRONFRONT_PUBLIC_IP=203.0.113.10

# --- TLS -------------------------------------------------------------------------------
# Password for /opt/ironfront/tls/master.pfx (the PEM->PKCS#12 conversion in
# infra/tls/issue-cert.sh sets it). Registered for log redaction at startup.
IRONFRONT_TLS_CERT_PASSWORD=

# Self-signed + IP mode ONLY (no domain, deploy via infra/compose/deploy-selfsigned.sh):
# lifetime in days of the self-signed certificate. Optional; the script defaults to 825.
# Unused by the Let's Encrypt path below.
#   IRONFRONT_SELFSIGNED_DAYS=825

# --- ACME (host-side; read by infra/tls/issue-cert.sh + renew-hook.sh, not by compose) --
# Email for Let's Encrypt expiry reminders (optional but recommended).
IRONFRONT_ACME_EMAIL=
# Challenge type: dns-manual (default, no open port, does NOT auto-renew) | dns-plugin
# (hands-off renewal via a provider API) | http (needs 80/tcp opened deliberately).
IRONFRONT_ACME_CHALLENGE=dns-manual
# For dns-plugin only: the certbot plugin flag name and its credentials file (chmod 600,
# never committed). Example: dns-cloudflare + /opt/ironfront/tls/cloudflare.ini
#   IRONFRONT_ACME_DNS_PLUGIN=dns-cloudflare
#   IRONFRONT_ACME_DNS_CREDENTIALS=/opt/ironfront/tls/cloudflare.ini

# --- Tuning (optional; sane defaults live in compose.yaml) ----------------------------
IRONFRONT_LOG_LEVEL=Warn
IRONFRONT_GAMESERVER_MAX_PLAYERS=16
IRONFRONT_GAMESERVER_MAX_CONNECTIONS=16
# Comma-separated map ids per instance. REQUIRED, at least one id each.
# These shipped EMPTY, and empty is not "no preference" -- GameServerRegistry.TryRegister
# refuses a registration whose map list is empty. The master then said nothing, and the
# connection was closed 30 s later as "not authenticated", naming neither cause. A compose
# deployment done exactly by this file therefore had two game servers that never registered
# and a matchmaker that answered NoGameServerAvailable to every join. Dustbowl is 1.
# NOTE this advertises to the matchmaker and loads NOTHING. The scene below is what the
# server actually hosts; the two are unrelated and there is no id-to-scene table.
IRONFRONT_GAMESERVER_1_MAP_IDS=1
IRONFRONT_GAMESERVER_2_MAP_IDS=1
# The map scene both instances load at startup. A server that loads none binds no UDP port
# and accepts nobody while looking healthy from outside. Must name a scene in the build:
# Island or Dustbowl.
IRONFRONT_GAMESERVER_SCENE=Dustbowl
# Master memory cap; raise if the durability run shows it near the ceiling.
IRONFRONT_MASTER_MEMORY=768M

# Load-test rig ONLY (a single machine's bots all share one source address). Leave the
# production defaults in place for a real run.
#   IRONFRONT_MAX_CONNECTIONS_PER_IP=200
#   IRONFRONT_LOGIN_RATE_PER_MINUTE=500

# --- Bind-mount SOURCES on the host ---------------------------------------------------
# Where compose mounts /data and /tls from. Defaults match cloud-init's layout; override
# only if you relocate the install.
IRONFRONT_DATA_DIR=/opt/ironfront/data
IRONFRONT_TLS_DIR=/opt/ironfront/tls

# ======================================================================================
# HOST-SIDE ONLY below — consumed by the systemd timers (backup/alert), not by compose.
# ======================================================================================

# --- Backups (infra/systemd/ironfront-backup.*, tools/backup.sh + backup-upload.sh) ---
# HOST path to the database: the bind-mount SOURCE, i.e. IRONFRONT_DATA_DIR/ironfront.db.
# NOT the container's /data/ironfront.db.
IRONFRONT_DB_PATH=/opt/ironfront/data/ironfront.db
IRONFRONT_BACKUP_DIR=/opt/ironfront/backups
IRONFRONT_BACKUP_RETENTION_DAYS=7

# Off-host, encrypted-at-rest copy in Azure Blob (Terraform provisions the account and
# container and grants the VM's managed identity Storage Blob Data Contributor scoped to
# it). backup-upload.sh authenticates with `az login --identity` — no key or SAS is
# stored here or in Terraform state.
IRONFRONT_BACKUP_BLOB_ACCOUNT=
IRONFRONT_BACKUP_BLOB_CONTAINER=db-backups

# --- Alerting (infra/systemd/ironfront-alert.*, tools/alert.sh) -----------------------
# alert.sh reads the master's metrics on the host loopback publish (compose maps
# 127.0.0.1:27001 -> master:27001).
IRONFRONT_METRICS_HOST=127.0.0.1
IRONFRONT_METRICS_PORT=27001
# Discord/Telegram webhook. Empty computes alerts but delivers nothing (useful while
# tuning). Fill it out of band on the VM.
IRONFRONT_ALERT_WEBHOOK=
IRONFRONT_ALERT_ERRORS_PER_MIN=10
IRONFRONT_ALERT_RSS_GROWTH_PERCENT=50
IRONFRONT_ALERT_STATE=/opt/ironfront/alert-state
