# Standalone Ironfront .env file managed by Ansible
IRONFRONT_MASTER_IMAGE={{ standalone_master_image }}
IRONFRONT_GAMESERVER_IMAGE={{ standalone_gameserver_image }}
IRONFRONT_SHARED_SECRET={{ ironfront_shared_secret }}
IRONFRONT_DOMAIN={{ standalone_domain }}
IRONFRONT_PUBLIC_IP={{ standalone_public_ip }}
IRONFRONT_TLS_CERT_PASSWORD={{ lookup('env', 'IRONFRONT_TLS_CERT_PASSWORD') | default('', true) }}
IRONFRONT_DATA_DIR={{ ironfront_data_dir }}
IRONFRONT_TLS_DIR={{ standalone_tls_dir }}
