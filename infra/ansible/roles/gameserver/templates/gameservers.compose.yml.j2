# Game servers compose file managed by Ansible
name: ironfront-gameservers

x-gameserver: &gameserver
  image: {{ gameserver_image }}
  restart: unless-stopped
  environment: &gameserver-env
    IRONFRONT_SHARED_SECRET: "${IRONFRONT_SHARED_SECRET:?set IRONFRONT_SHARED_SECRET in .env}"
    IRONFRONT_MASTER_HOST: "{{ gameserver_master_host }}"
    IRONFRONT_MASTER_PORT: "{{ gameserver_master_port }}"
    IRONFRONT_GAMESERVER_MASTER_TLS: "{{ gameserver_master_tls }}"
    IRONFRONT_GAMESERVER_MASTER_TLS_TARGET_HOST: "{{ gameserver_master_tls_target_host }}"
    IRONFRONT_GAMESERVER_PUBLIC_IP: "{{ gameserver_public_ip }}"
    IRONFRONT_GAMESERVER_TRANSPORT: udp
    IRONFRONT_GAMESERVER_ACCEPT_UNSIGNED_TICKETS: "0"
    IRONFRONT_GAMESERVER_MAX_PLAYERS: "{{ gameserver_max_players }}"
    IRONFRONT_GAMESERVER_MAX_CONNECTIONS: "{{ gameserver_max_connections }}"
    IRONFRONT_LOG_LEVEL: "{{ gameserver_log_level }}"
    IRONFRONT_STRUCTURED_LOG: "1"
    IRONFRONT_LOG_FRAMES: "{{ gameserver_log_frames }}"
  logging:
    driver: json-file
    options: { max-size: "20m", max-file: "3" }

services:
{% for inst in gameserver_instances %}
  game-server-{{ inst.name }}:
    <<: *gameserver
    container_name: {{ inst.container_name }}
    environment:
      <<: *gameserver-env
      IRONFRONT_GAMESERVER_SCENE: "{{ inst.scene }}"
      IRONFRONT_GAMESERVER_UDP_PORT: "{{ inst.port }}"
      IRONFRONT_GAMESERVER_MAP_IDS: "{{ inst.map_ids }}"
    ports:
      - "{{ inst.port }}:{{ inst.port }}/udp"

{% endfor %}
