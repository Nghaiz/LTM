# Ironfront Reborn — environment template.
# COMMIT this file. NEVER commit a real .env (see conventions.md section 1.4).
#
# GENERATED from Ironfront.Net.Configuration/EnvRegistry.cs — do not hand-edit.
# Add the variable there and regenerate:
#
#   IRONFRONT_WRITE_ENV_EXAMPLE=1 dotnet test Ironfront.Net.Configuration.Tests
#
# A variable that is not in the registry does not reach this file, and one that is
# reaches it automatically — which is what stops a documented setting from being
# read by nothing, and a setting that is read from being documented nowhere.
#
# Copying this file to .env changes NO behaviour. Every value written below is
# already what the code does, so the copy is a starting point to edit rather than
# a set of overrides. A blank value is not a gap to fill: for most variables it IS
# the default and it means something specific — standalone, plaintext, disabled,
# no preference, inherited from the scene. The comment on each one says which.
#
# IRONFRONT_SHARED_SECRET is the one exception: blank there means unset, the master
# server refuses to start, and that is deliberate.

# --- Identity and secrets -------------------------------------------------
# Read by: master server, game server
# The HMAC key that signs joinTickets. The master server (the master-server track) issues tickets with
# it and the game server (the replication track) verifies them with it — both processes must be
# configured with the SAME value, or every CONNECT_REQUEST is rejected with
# CONNECT_DENIED reason 3.
#
# There is no default and there will not be one: a development default follows you to
# production, and a shared key that reached a git history is not a key any more. The
# master server refuses to start without it; the game server stays standalone.
#
# Do not fill this in by hand. Run:
#   pwsh tools/new-env.ps1
#
# It writes a .env from this template with a key from RandomNumberGenerator. The
# instruction here used to be a Get-Random one-liner, which is a clock-seeded PRNG:
# adequate for choosing a test case and not for a key whose predictability means
# forgeable joinTickets.
#
# You need the SAME key as somebody else only when you share a master server. Running
# your own master and game server means any key will do — generate your own and send
# it nowhere. If you do have to pass one on, it goes out of band: never a commit, a
# PR, an issue or a screenshot.
IRONFRONT_SHARED_SECRET=

# --- Master server --------------------------------------------------------
# Read by: master server, game server
# The master's single TCP port. Clients and game servers both dial it — GS_REGISTER
# travels the same MSP connection as a player login, so there is no second port to
# configure and a game server pointed at one will simply never reach the master.
IRONFRONT_MASTER_PORT=27000

# Read by: game server
# Where a game server finds the master. EMPTY MEANS STANDALONE: no connection, no
# advertisement, matches still play to completion. That is the phase-03 contingency
# for the master not being up, and it is deliberately what you get by doing nothing.
IRONFRONT_MASTER_HOST=

# Read by: game server
# Set to 1 when the master listener presents TLS. A game server sends the shared
# server secret while registering, so a public deployment must not leave this
# link in plaintext.
IRONFRONT_GAMESERVER_MASTER_TLS=0

# Read by: game server
# Certificate name for the master TLS connection. Empty uses IRONFRONT_MASTER_HOST.
# Set this when the game server dials an internal Compose service name but the
# certificate names the public domain.
IRONFRONT_GAMESERVER_MASTER_TLS_TARGET_HOST=

# Read by: game server
# SHA-256 certificate fingerprint for a self-signed master certificate. Leave empty
# for a publicly trusted certificate such as Let's Encrypt. Never use an
# accept-any-certificate switch in a deployment.
IRONFRONT_GAMESERVER_MASTER_TLS_PINNED_FINGERPRINT_SHA256=

# Read by: master server, tools/backup.sh
# The SQLite file holding accounts, sessions and the room registry.
IRONFRONT_DB_PATH=./ironfront.db

# --- Game server ----------------------------------------------------------
# Read by: game server, client
# server | client. Declared BEFORE any scene loads, which is the whole point.
#
# Dustbowl carries an active NetServer AND an active NetClient, so every process that
# loads it runs both bootstraps, and each claims the role only if the other has not.
# Both sit at execution order -1000, so with nothing declared which one wins is
# Unity's tie to break. That is not cosmetic: every client presenter latches
# enabled = false during the same Awake pass and never re-checks, so a process that
# loses the flip has a dead killfeed, name table and local combat driver for the rest
# of its life.
#
# SHIPPED BLANK, and the blank behaviour is unchanged: the bootstraps decide exactly
# as they always have, which is what keeps offline single-player and the Editor
# sandbox working. A headless process needs nothing here either -- it is inferred to
# be a server. What this exists for is a RENDERED process that is a client, which had
# no way to say so at all.
#
# NOT IRONFRONT_LANEB_ROLE. That one also installs the lane-B harness, strips a
# bootstrap and writes checkpoint artifacts; this one only names a role, so setting it
# on a player build cannot drag verification scaffolding in. The command line
# -ironfront-role=client is the same declaration for a launcher that cannot set an
# environment.
IRONFRONT_ROLE=

# Read by: game server
# The UDP port the game server binds AND the port it advertises to the master, which
# are necessarily the same number — clients dial what the matchmaker hands them.
# Overrides the Unity inspector field, so a second instance on one host needs no
# second scene.
IRONFRONT_GAMESERVER_UDP_PORT=27015

# Read by: game server
# udp | loopback. The loopback wire is an in-process pipe with no socket, for driving
# both ends from one Editor; anything reachable over a network needs udp.
#
# SHIPPED BLANK ON PURPOSE, unlike every other value in this file. The others repeat
# a default that matches what the code already does, so copying this template changes
# nothing. This one does not: the scene ships with the loopback wire on, because that
# is what a single-Editor test wants, so writing 'udp' here would silently switch the
# Editor to real sockets for anyone who copied the template. Blank leaves the scene
# alone.
#
# A DEPLOYMENT MUST SET IT. A headless build left on loopback starts cleanly, logs
# nothing unusual and accepts nobody — so tools/deploy/ironfront-gameserver@.service
# sets udp explicitly rather than inheriting it from anywhere.
IRONFRONT_GAMESERVER_TRANSPORT=

# Read by: game server
# Transport-level connection slots. Keep it at or above the advertised player count —
# the difference is spectators and reconnect churn, not headroom for a flood.
IRONFRONT_GAMESERVER_MAX_CONNECTIONS=16

# Read by: game server
# The player count advertised to the master, which is what the matchmaker fills.
# 0..255: the wire carries it as a byte.
IRONFRONT_GAMESERVER_MAX_PLAYERS=16

# Read by: game server
# The address clients dial. Empty means the master infers it from the connection,
# which is right on a plain VPS and wrong behind NAT or a port-forward — there the
# master sees the gateway and the clients need the mapped address.
IRONFRONT_GAMESERVER_PUBLIC_IP=

# Read by: game server
# Comma-separated map ids this server can host, driving the matchmaker's
# preferred-map filter. REQUIRED, and at least one id: GameServerRegistry.TryRegister
# refuses a registration whose map list is empty, so a server started without this
# is turned away and then closed 30 s later as an unauthenticated connection. This
# line used to read 'Empty means no preference', which is the opposite of what the
# code does; infra/compose/.env.example shipped it empty, so a by-the-book compose
# deployment could never register a game server at all. Dustbowl is 1.
IRONFRONT_GAMESERVER_MAP_IDS=1

# Read by: game server
# The map scene a headless dedicated server loads at startup. Without it the build
# boots Splash then Menu and stops there: NetServerBootstrap is a component that
# lives in a map scene, so nothing binds the UDP port and the process sits healthy
# and unreachable. Distinct from IRONFRONT_GAMESERVER_MAP_IDS, which only tells the
# matchmaker what this server is willing to host and loads nothing.
IRONFRONT_GAMESERVER_SCENE=Dustbowl

# Read by: game server
# Accept any join ticket when no shared secret is configured. DEVELOPMENT ONLY: it
# bypasses the protocol-spec section 12 HMAC check, so a public server running with
# it on is a server anyone can join as anyone. Set it to 0 on anything reachable
# from the Internet; the server then refuses every connection until the secret is
# present, which is the failure you want.
IRONFRONT_GAMESERVER_ACCEPT_UNSIGNED_TICKETS=1

# --- Game client ----------------------------------------------------------
# Read by: game client
# The game server a client build connects to, for a headless or scripted run. In the
# Editor the inspector field is the convenient one and wins whenever this is unset.
IRONFRONT_CLIENT_HOST=127.0.0.1

# Read by: game client
# Matches the game server's IRONFRONT_GAMESERVER_UDP_PORT.
IRONFRONT_CLIENT_PORT=27015

# Read by: game client
# Log the first snapshot and every connection state change.
IRONFRONT_CLIENT_VERBOSE=1

# Read by: game client
# Whether the client predicts the vehicle it is driving. Set to 0 for the
# no-prediction fallback: the driven vehicle is interpolated like every other
# one, correct but a round trip behind. Flip it when the net-debug overlay
# shows the snap count rising under a healthy network.
IRONFRONT_CLIENT_PREDICT_VEHICLE=1

# Read by: game client
# The master server a client logs in against. Distinct from IRONFRONT_MASTER_HOST,
# which is what a GAME SERVER dials to register itself -- the two are the same box
# in most deployments and different ones whenever a client reaches the master
# through a public name while the game servers reach it over a private network.
# UNSET keeps the scene's field, so nothing changes in the Editor.
IRONFRONT_CLIENT_MASTER_HOST=127.0.0.1

# Read by: game client
# Matches the master's IRONFRONT_MASTER_PORT.
IRONFRONT_CLIENT_MASTER_PORT=27020

# Read by: game client
# The playerId written into the join ticket a client mints for itself, on the runs
# with no master server in them. It must be DISTINCT PER CLIENT and never 0: the
# game server enforces one session per player once a shared secret is configured,
# so two clients sharing an id have the second join rejected -- and the rejection
# is reported as a bare InvalidTicket, which reads as a full server and is not one.
# UNSET derives one from the process id, above the range the load harness numbers
# its synthetic clients from, so several clients on one machine do not collide.
# Set it explicitly when a run has to be replayed against the same identities.
IRONFRONT_CLIENT_PLAYER_ID=

# Read by: game client
# The displayName written into that ticket, truncated to 16 UTF-8 bytes. This is
# where a killfeed line gets its name, so a scripted two-client run that leaves
# both instances on the default produces a killfeed nobody can read.
IRONFRONT_CLIENT_DISPLAY_NAME=player

# --- Logging --------------------------------------------------------------
# Read by: master server
# Error | Warn | Debug. Debug logs per-connection and per-frame detail and will fill
# a VPS disk in days — keep it at Warn outside an investigation.
IRONFRONT_LOG_LEVEL=Warn

# Read by: master server
# 1 emits one JSON object per line on stdout beside the human log, for jq and log
# aggregation. Values registered as secrets are redacted before writing.
IRONFRONT_STRUCTURED_LOG=0

# --- TLS ------------------------------------------------------------------
# Read by: master server
# Empty means PLAINTEXT. That is fine on a LAN and NOT fine on the Internet: the wire
# carries a password hash and a session token, and to the server the hash IS the
# password — anyone who captures it can log in as that account.
#
# Generate a certificate and get the fingerprint to pin in the client:
#   ./tools/new-dev-cert.ps1 -Subject <hostname> -AlsoValidFor <ip>
IRONFRONT_TLS_CERT_PATH=

# Read by: master server
# The certificate bundle's password. Registered for redaction at startup and never
# printed.
IRONFRONT_TLS_CERT_PASSWORD=

# --- Metrics and durability -----------------------------------------------
# Read by: master server, tools/alert.sh
# `nc 127.0.0.1 27001` prints a JSON snapshot. 0 disables the endpoint. It must differ
# from IRONFRONT_MASTER_PORT or the second listener fails to bind.
IRONFRONT_METRICS_PORT=27001

# Read by: master server
# The bind address stays on loopback deliberately: the payload is unauthenticated and
# tells anyone who can reach it how many players are online and whether a game server
# is down. Reach it over the SSH session you already have.
IRONFRONT_METRICS_BIND=127.0.0.1

# Read by: tools/alert.sh
# Where tools/alert.sh looks for the metrics endpoint. Loopback, for the same reason
# the endpoint binds there — the script runs from cron on the same box.
IRONFRONT_METRICS_HOST=127.0.0.1

# Read by: master server
# One CSV row per interval, for the durability chart (tools/chart-durability.ps1).
# Empty disables sampling.
IRONFRONT_METRICS_CSV=

# Read by: master server
# Seconds between durability CSV rows.
IRONFRONT_METRICS_CSV_INTERVAL_SEC=60

# --- Limits ---------------------------------------------------------------
# Read by: master server
# The defaults below are sized for real players and are correct for production.
#
# They are also what makes a single-machine load test impossible, because every bot
# shares one source address: with the defaults, a 16-client run gets 5 connections and
# 5 logins and 11 errors. Raise them ONLY on a test rig:
#
#   IRONFRONT_MAX_CONNECTIONS_PER_IP=200
#   IRONFRONT_LOGIN_RATE_PER_MINUTE=500
IRONFRONT_MAX_CONNECTIONS_PER_IP=5

# Read by: master server
# Global connection cap. 0 removes it.
IRONFRONT_MAX_TOTAL_CONNECTIONS=256

# Read by: master server
# Per-IP login attempts per minute.
IRONFRONT_LOGIN_RATE_PER_MINUTE=5

# --- Diagnostics ----------------------------------------------------------
# Read by: game server, game client, tools/PacketReplay
# Write every datagram to this file, for Ironfront.Tools.PacketReplay. Empty disables
# capture. It records payloads verbatim, so treat a capture from a live server as
# sensitive.
IRONFRONT_PCAP=

# Read by: game server, game client
# Impair the local network on purpose: a preset name from SimulatorConfig (for example
# wifi, mobile, terrible). Empty or unrecognised means no simulation — a typo must not
# silently degrade a real server.
IRONFRONT_SIM=

# Read by: game server, game client
# Seeds the simulator's RNG so a bad run reproduces. Empty means a fresh seed each
# start.
IRONFRONT_SIM_SEED=

# --- Deployment scripts ---------------------------------------------------
# Read by: tools/backup.sh
# Install root on the VPS: where the database and the backups live.
IRONFRONT_ROOT=/opt/ironfront

# Read by: tools/deploy.sh
# The same directory as IRONFRONT_ROOT, named from the deploying machine's side.
IRONFRONT_REMOTE_ROOT=/opt/ironfront

# Read by: tools/backup.sh
# Where dumps are written. Defaults to a backups/ directory under IRONFRONT_ROOT,
# which is on the same disk as the database — point it elsewhere if the backup is
# meant to survive losing that disk.
IRONFRONT_BACKUP_DIR=

# Read by: tools/backup.sh
# Days of dumps to keep. Older ones are deleted on the next run.
IRONFRONT_BACKUP_RETENTION_DAYS=7

# --- Alerting -------------------------------------------------------------
# Read by: tools/alert.sh
# Where tools/alert.sh posts, run from cron. Empty means alerts are computed and not
# delivered, which is the same as no alerting.
IRONFRONT_ALERT_WEBHOOK=

# Read by: tools/alert.sh
# Errors per minute above which an alert fires.
IRONFRONT_ALERT_ERRORS_PER_MIN=10

# Read by: tools/alert.sh
# Resident-memory growth, as a percentage of the first sample, that fires a leak
# alert.
IRONFRONT_ALERT_RSS_GROWTH_PERCENT=50

# Read by: tools/alert.sh
# Where the alert script remembers the previous sample, so it reports a change rather
# than a level and does not repeat itself every minute.
IRONFRONT_ALERT_STATE=/tmp/ironfront-alert-state
