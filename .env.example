# Ironfront Reborn — environment template.
# COMMIT this file. NEVER commit a real .env (see conventions.md section 1.4).
#
# IRONFRONT_SHARED_SECRET is the HMAC key that signs joinTickets. The master
# server (Dev D) issues tickets with it and the game server (Dev C) verifies
# them with it — both processes must be configured with the SAME value, or every
# CONNECT_REQUEST is rejected with CONNECT_DENIED reason 3.
#
# Generate one with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))

IRONFRONT_SHARED_SECRET=
IRONFRONT_DB_PATH=./ironfront.db
IRONFRONT_MASTER_PORT=27000
IRONFRONT_GAMESERVER_UDP_PORT=27015

# --- Logging ---------------------------------------------------------------
# Error | Warn | Debug. Debug logs per-connection and per-frame detail and will
# fill a VPS disk in days — keep it at Warn outside an investigation.
IRONFRONT_LOG_LEVEL=Warn

# 1 emits one JSON object per line on stdout beside the human log, for jq and
# log aggregation. Values registered as secrets are redacted before writing.
IRONFRONT_STRUCTURED_LOG=0

# --- TLS (phase 03) --------------------------------------------------------
# Empty means PLAINTEXT. That is fine on a LAN and NOT fine on the Internet: the
# wire carries a password hash and a session token, and to the server the hash IS
# the password — anyone who captures it can log in as that account.
#
# Generate a certificate and get the fingerprint to pin in the client:
#   ./tools/new-dev-cert.ps1 -Subject <hostname> -AlsoValidFor <ip>
IRONFRONT_TLS_CERT_PATH=
IRONFRONT_TLS_CERT_PASSWORD=

# --- Metrics and durability (phase 03) -------------------------------------
# `nc 127.0.0.1 27001` prints a JSON snapshot. 0 disables the endpoint.
#
# The bind address stays on loopback deliberately: the payload is unauthenticated
# and tells anyone who can reach it how many players are online and whether a game
# server is down. Reach it over the SSH session you already have.
IRONFRONT_METRICS_PORT=27001
IRONFRONT_METRICS_BIND=127.0.0.1

# One CSV row per interval, for the durability chart (tools/chart-durability.ps1).
# Empty disables sampling.
IRONFRONT_METRICS_CSV=
IRONFRONT_METRICS_CSV_INTERVAL_SEC=60

# --- Limits ----------------------------------------------------------------
# The defaults are sized for real players and are correct for production.
#
# They are also what makes a single-machine load test impossible, because every
# bot shares one source address: with the defaults, a 16-client run gets 5
# connections and 5 logins and 11 errors. Raise them ONLY on a test rig.
#
#   IRONFRONT_MAX_CONNECTIONS_PER_IP=200
#   IRONFRONT_LOGIN_RATE_PER_MINUTE=500
IRONFRONT_MAX_CONNECTIONS_PER_IP=5
IRONFRONT_MAX_TOTAL_CONNECTIONS=256
IRONFRONT_LOGIN_RATE_PER_MINUTE=5

# --- Alerting (tools/alert.sh, run from cron) ------------------------------
IRONFRONT_ALERT_WEBHOOK=
IRONFRONT_ALERT_ERRORS_PER_MIN=10
