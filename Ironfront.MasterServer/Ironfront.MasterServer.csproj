<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OWNER: Dev D (Master Server and Services). Nobody else may edit this project
    (plans/00-shared/conventions.md section 7).

    Scaffolded empty by the M0 foundation pass. Dev D fills it in per
    plans/dev-d-master-server/plan.md: TcpListenerHost, MspFraming, AuthService,
    LobbyService, MatchmakingService, SQLite data layer.

    net8.0 (not netstandard2.1) because this is a standalone console process that Unity
    never loads.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ironfront.MasterServer</RootNamespace>
    <AssemblyName>Ironfront.MasterServer</AssemblyName>
    <Description>TCP master server: auth, lobby, room registry, matchmaking, chat.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironfront.Net.Protocol\Ironfront.Net.Protocol.csproj" />
    <ProjectReference Include="..\Ironfront.Net.Configuration\Ironfront.Net.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Version pin only — see the GHSA-2m69-gcr7-jv3q note in Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

  <!--
    The test project drives the single logic thread (D-AD-1) through InvokeOnLogicThreadAsync
    and reads ConnectionsUnsafe / calls MarkAuthenticated on it — which is precisely how the
    XML docs on those members say host state must be touched from another thread. Exposing
    them to the tests rather than making them public keeps that contract internal to Dev D's
    code and out of the public API A and C consume.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ironfront.MasterServer.Tests" />
  </ItemGroup>

</Project>
