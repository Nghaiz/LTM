<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The conformance suite — the referee whenever two people disagree about the protocol
    (protocol-spec.md section 14).

    OWNERSHIP NOTE: conventions.md section 7 assigns the conformance tests to Dev C, in
    Ironfront.Net.Replication.Tests/Conformance/, specifically so that the person who
    implements the serializer (Dev B) is not the person who verifies it. This project was
    scaffolded during the M0 foundation pass because the shared Ironfront.Net.Protocol
    library needed a green gate before anyone could depend on it. Dev C should either
    adopt this project or move its contents into the owned location — but the
    implementer/verifier split must survive whichever way that goes.

    net8.0 (not netstandard2.1) because it is a test host, never loaded by Unity. It
    references the netstandard2.1 library, which net8.0 consumes fine.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ironfront.Net.Protocol.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Versions deliberately absent: they live in the repo-root Directory.Packages.props
    (Central Package Management). Adding a Version="..." back here is an NU1008 restore
    error, not a silent override — that is the point.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!--
      Produces the Cobertura file that the "XPlat Code Coverage" data collector writes into
      TestResults/ (see the dotnet test invocation in .github/workflows/ci.yml). Without this
      package the collector silently emits nothing and CI reports a green coverage step that
      measured zero lines.
    -->
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironfront.Net.Protocol\Ironfront.Net.Protocol.csproj" />
  </ItemGroup>

</Project>
