<Project>

  <!--
    Central Package Management — every NuGet version for the whole solution lives here.

    OWNER: shared (it is a build contract), maintained with tools/ by Dev D.

    WHY: with versions written into individual .csproj files, four people adding test
    projects over four months end up pinning three different xunit versions. The symptom is
    not a clean error — it is one project silently restoring a different assembly than the
    others and a test that passes on one machine and fails on another. Here there is exactly
    one place to look and one place to change.

    HOW TO ADD A PACKAGE:
      1. Add a <PackageVersion Include="Foo" Version="1.2.3" /> line below.
      2. In the .csproj, write <PackageReference Include="Foo" />  — WITHOUT a Version.
      Putting a Version in the .csproj while CPM is on is an error (NU1008), on purpose.

    REMINDER (conventions.md section 3.4): netcode frameworks are a hard no. Anything that
    shows up here must be dev tooling or a BCL primitive package, never Mirror / LiteNetLib /
    ENet / KCP / SignalR / gRPC.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Fails restore if a .csproj still carries an inline Version. Without this the inline
      version wins silently and CPM becomes decorative.
    -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Label="Master Server">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <!--
      Pinned ahead of what Microsoft.Data.Sqlite 8.0.12 asks for (2.1.6). Every
      SQLitePCLRaw.lib.e_sqlite3 up to and including 2.1.11 bundles a SQLite build carrying
      GHSA-2m69-gcr7-jv3q (High), which the CI vulnerable-package scan fails on. Referenced
      directly by Ironfront.MasterServer so this version wins over the transitive one; the
      test project inherits it through the project reference. Drop this pin once
      Microsoft.Data.Sqlite ships a net8.0 build that already resolves to 2.1.12 or later.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <!--
      Used ONLY by Ironfront.Tools.MspBench, for the phase-04 experiment that compares the
      hand-written MspFrameReader against the standard-library answer to the same problem
      (conventions.md section 3.4 names this comparison explicitly).

      This is a BCL primitive, not a netcode framework — it is a buffer abstraction, in the
      same category as ArrayPool<T> and System.Threading.Channels, both of which section 3.4
      lists as allowed. It is deliberately NOT referenced by Ironfront.Net.Protocol: the
      shipped reader stays hand-written, because writing it is the lesson.

      It needs a PackageReference despite looking like part of the BCL: System.IO.Pipelines
      ships in the ASP.NET Core shared framework, not in Microsoft.NETCore.App.
    -->
    <PackageVersion Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Build tooling">
    <!--
      Used ONLY by tools/UnitySyntaxCheck, which parses Ironfront_Reborn/Assets/Scripts at
      Unity's C# language version so that a broken brace in a Unity script is caught by a
      gate rather than by Dev A opening the Editor. Nothing shipped references it.

      Dev tooling, not a netcode framework — section 3.4's hard no does not apply.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Test host">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!--
      Required by the "XPlat Code Coverage" data collector that ci.yml asks dotnet test for.
      Without this package the collector produces no coverage file and the CI step reports
      success while measuring nothing — a silent hole, worse than no coverage at all.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
